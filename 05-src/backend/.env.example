# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string from your Supabase / Neon project.
# Example (Supabase): postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Long random string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# One-time key required to register the first admin account(s) via POST /api/auth/register.
# Pick your own value, keep it private, rotate/remove it once your admin accounts exist.
ADMIN_SETUP_KEY="replace-with-a-one-time-setup-key"

PORT=4000
