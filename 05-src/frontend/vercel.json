{
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/community.html",
      "destination": "/events.html",
      "permanent": true
    },
    {
      "source": "/media.html",
      "destination": "/news.html",
      "permanent": true
    }
  ]
}
